<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="15.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.client.AuthController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>
    
    <Label text="Online Auction System" style="-fx-font-size: 22px; -fx-font-weight: bold;"/>
    <Label text="Please Login or Sign Up" style="-fx-font-size: 14px; -fx-text-fill: gray;"/>
    
    <TextField fx:id="usernameField" promptText="Username" maxWidth="250"/>
    <PasswordField fx:id="passwordField" promptText="Password" maxWidth="250"/>
    
    <HBox spacing="20.0" alignment="CENTER">
        <Button text="Login" onAction="#handleLoginAction" prefWidth="100" style="-fx-background-color: #2196F3; -fx-text-fill: white;"/>
        <Button text="Sign Up" onAction="#handleSignupAction" prefWidth="100" style="-fx-background-color: #4CAF50; -fx-text-fill: white;"/>
    </HBox>
    
    <Label fx:id="statusLabel" textFill="red" wrapText="true" maxWidth="300"/>
</VBox>